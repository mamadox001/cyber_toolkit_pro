# =============================================================================
# CyberToolkit Pro — .gitignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs & Reports (generated)
logs/*.log
logs/*.json
logs/audit/*.jsonl
reports/*.json
reports/*.html

# Database (generated)
data/*.db

# Vault (sensitive)
config/.vault

# Keep directory structure
!logs/.gitkeep
!reports/.gitkeep
!data/.gitkeep
!logs/audit/.gitkeep

# Environment
.env
.env.local
